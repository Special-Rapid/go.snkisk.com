{
  "name": "go-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "wrangler d1 execute go_shortener --local --file=./schema.sql",
    "db:apply:remote": "wrangler d1 execute go_shortener --remote --file=./schema.sql",
    "db:migrate:link-behaviors:local": "wrangler d1 migrations apply go_shortener --local",
    "db:migrate:link-behaviors:remote": "wrangler d1 migrations apply go_shortener --remote",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "^5.0.0",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "jose": "^6.2.9",
    "qrcode-generator": "2.0.4"
  }
}
