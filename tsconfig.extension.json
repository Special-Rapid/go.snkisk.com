{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "module": "None",
    "moduleResolution": "Node10",
    "resolveJsonModule": false,
    "allowImportingTsExtensions": false,
    "moduleDetection": "legacy",
    "alwaysStrict": false,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "./extension",
    "outDir": "./extension"
  },
  "include": [
    "extension/popup.ts",
    "extension/chrome.d.ts"
  ],
  "exclude": []
}
