import assert from "node:assert/strict";
import test from "node:test";
import {runInNewContext} from "node:vm";
import {localizationCoreCode} from "../src/localization-core-script.ts";
class ElementMock {tagName:string;children:(ElementMock|TextMock)[]=[];attributes:Record<string,string>={};constructor(tag="DIV"){this.tagName=tag}querySelectorAll(selector:string){const key=selector.slice(1,-1),a:ElementMock[]=[];const walk=(x:ElementMock)=>{for(const c of x.children)if(c instanceof ElementMock){if(key in c.attributes)a.push(c);walk(c)}};walk(this);return a}getAttribute(k:string){return this.attributes[k]??null}setAttribute(k:string,v:string){this.attributes[k]=v}}
class TextMock {nodeType=3;nodeValue:string|null;parentElement:ElementMock|null;constructor(value:string|null,parent:ElementMock|null){this.nodeValue=value;this.parentElement=parent;parent?.children.push(this)}}
class SelectMock extends ElementMock {value="";fn:(()=>void)|undefined;addEventListener(name:string,fn:()=>void){assert.equal(name,"change");this.fn=fn}}
type RecordMock={type:string,target:TextMock,addedNodes:(ElementMock|TextMock|{nodeType:number})[]};
function page(saved:string|null=null,languages=["en-US"],storageError=false){
 const body=new ElementMock("BODY"),picker=new SelectMock(),traces:string[]=[],events:{type:string,detail:{locale:string,preference:string}}[]=[],storage=new Map<string,string>();if(saved!==null)storage.set("go_locale",saved);let mutation:((records:RecordMock[])=>void)|undefined;
 const document={documentElement:{lang:""},body,title:"設定内容",querySelector:(s:string)=>{assert.equal(s,"#ui_locale");return picker},createTreeWalker(root:ElementMock,filter:number){assert.equal(filter,4);traces.push("walk");const a:TextMock[]=[];const walk=(x:ElementMock)=>{for(const n of x.children)n instanceof TextMock?a.push(n):walk(n)};walk(root);let i=0;return {currentNode:a[0],nextNode(){this.currentNode=a[i++];return this.currentNode!==undefined}}},dispatchEvent(e:{type:string,detail:{locale:string,preference:string}}){events.push({type:e.type,detail:JSON.parse(JSON.stringify(e.detail))});return true}};
 const window:{goTranslateText?:(v:string)=>string,goSetUiLocale?:(v:string)=>void,goRegisterTranslationWords?:(v:Record<string,string>)=>void,goUiLocale?:string}={};
 return {body,picker,document,window,traces,events,storage,start(){runInNewContext(localizationCoreCode,{document,window,Element:ElementMock,HTMLSelectElement:SelectMock,Node:{TEXT_NODE:3},NodeFilter:{SHOW_TEXT:4},navigator:{languages,language:languages[0]??""},localStorage:{getItem(k:string){traces.push("get");if(storageError)throw Error("storage denied");return storage.get(k)??null},setItem(k:string,v:string){traces.push("set");if(storageError)throw Error("storage denied");storage.set(k,v)},removeItem(k:string){traces.push("remove");if(storageError)throw Error("storage denied");storage.delete(k)}},CustomEvent:class{type:string;detail:object;constructor(type:string,options:{detail:object}){this.type=type;this.detail=options.detail}},MutationObserver:class{constructor(fn:(records:RecordMock[])=>void){mutation=fn;traces.push("observer")}disconnect(){traces.push("disconnect")}observe(root:ElementMock,options:object){assert.equal(root,body);assert.deepEqual(JSON.parse(JSON.stringify(options)),{subtree:true,childList:true,characterData:true});traces.push("observe")}}})},mutate(records:RecordMock[]){assert(mutation);mutation(records)}};
}
test("保存済みmanualをOSより優先し初期化でstorage書込と通知をしない",()=>{const p=page("ja",["en-US"]),t=new TextMock("設定内容",p.body);p.start();assert.equal(p.document.documentElement.lang,"ja");assert.equal(p.window.goUiLocale,"ja");assert.equal(t.nodeValue,"設定内容");assert.deepEqual(p.events,[]);assert.deepEqual(p.traces,["get","walk","observer","observe"]);assert.equal(p.picker.value,"ja")});
test("保存不在・不正・例外は既存OS判定でjaを探しそれ以外enにする",()=>{for(const saved of [null,"auto","fr"]){const p=page(saved,["en-US","ja-JP"]);p.start();assert.equal(p.window.goUiLocale,"ja")}const p=page("ja",["fr"],true);p.start();assert.equal(p.window.goUiLocale,"en");assert.deepEqual(p.events,[])});
test("manual切替は保存しautoは削除してobserver pause後にlocale通知する",()=>{const p=page(null,["en"]),t=new TextMock("設定内容",p.body);p.start();assert.equal(t.nodeValue,"Settings summary");assert(p.window.goSetUiLocale);p.window.goSetUiLocale("ja");assert.equal(t.nodeValue,"設定内容");assert.equal(p.storage.get("go_locale"),"ja");assert.deepEqual(p.traces.slice(-4),["set","disconnect","walk","observe"]);assert.deepEqual(p.events[0],{type:"go:localechange",detail:{locale:"ja",preference:"ja"}});p.window.goSetUiLocale("unknown");assert.equal(p.storage.has("go_locale"),false);assert.equal(p.window.goUiLocale,"en");assert.equal(p.events[1].detail.preference,"auto")});
test("text空白とplaceholder・altを往復し除外tagと孤立Nodeを保持する",()=>{const p=page("en"),t=new TextMock(" 設定内容\n",p.body),excluded=new ElementMock("SCRIPT"),input=new ElementMock("INPUT"),image=new ElementMock("IMG");p.body.children.push(excluded,input,image);const x=new TextMock("設定内容",excluded),orphan=new TextMock("設定内容",null);p.body.children.push(orphan);input.attributes.placeholder="未入力なら自動生成";image.attributes.alt="短縮URLのQRコード";p.start();assert.equal(t.nodeValue," Settings summary\n");assert.equal(x.nodeValue,"設定内容");assert.equal(orphan.nodeValue,"設定内容");assert.equal(input.attributes.placeholder,"Leave blank to generate automatically");assert.equal(image.attributes.alt,"QR code for the short URL");assert(p.window.goSetUiLocale);p.window.goSetUiLocale("ja");assert.equal(input.attributes.placeholder,"未入力なら自動生成");assert.equal(image.attributes.alt,"短縮URLのQRコード")});
test("辞書登録は通知・保存なしで既存bodyを翻訳し逆変換を更新する",()=>{const p=page("en"),t=new TextMock("追加語",p.body);p.start();assert.equal(t.nodeValue,"追加語");assert(p.window.goRegisterTranslationWords);p.window.goRegisterTranslationWords({追加語:"Added word"});assert.equal(t.nodeValue,"Added word");assert.deepEqual(p.events,[]);assert.equal(p.traces.includes("set"),false);assert(p.window.goTranslateText);assert.equal(p.window.goTranslateText(" 3 / 4 回使用済み ")," 3 / 4 used ");assert.equal(p.window.goTranslateText("unknown"),"unknown");assert(p.window.goSetUiLocale);p.window.goSetUiLocale("ja");assert.equal(t.nodeValue,"追加語")});
test("MutationObserverはTextとElementを処理し既存picker changeを保持する",()=>{const p=page("en");p.start();const t=new TextMock("設定内容",p.body),branch=new ElementMock(),b=new TextMock("設定内容",branch);p.body.children.push(branch);p.mutate([{type:"characterData",target:t,addedNodes:[]},{type:"childList",target:t,addedNodes:[branch,{nodeType:8}]}]);assert.equal(t.nodeValue,"Settings summary");assert.equal(b.nodeValue,"Settings summary");assert.deepEqual(p.traces.slice(-3),["disconnect","walk","observe"]);p.picker.value="ja";assert(p.picker.fn);p.picker.fn();assert.equal(t.nodeValue,"設定内容");assert.equal(p.events.at(-1)?.detail.locale,"ja")});
