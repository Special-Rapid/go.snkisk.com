import assert from "node:assert/strict";
import test from "node:test";
import {runInNewContext} from "node:vm";
import {createQueryPresetCode} from "../src/create-query-preset-script.ts";
class Control {name:string;value="";events:string[]=[];constructor(name:string){this.name=name}dispatchEvent(event:{type:string}){this.events.push(event.type);return true}}
class Input extends Control {type="text";checked=false}
class Select extends Control {options:{value:string}[]=[]}
class TextArea extends Control {}
class Details {open=false}
class Form {controls:Control[]=[];details=new Details;events:string[]=[];elements={namedItem:(name:string)=>this.controls.find(c=>c.name===name)??null};querySelectorAll(selector:string){const name=/name="([^"]+)"/.exec(selector)?.[1];return this.controls.filter(c=>c.name===name)}querySelector(selector:string){assert.equal(selector,".create-settings");return this.details}dispatchEvent(event:{type:string}){this.events.push(event.type);return true}}
function page(search:string,readyState="complete",present=true){const form=new Form,toggles=new Map<string,Input>();for(const name of ["period","limit","schedule","protection","end-display","preview","audience"]){const c=new Input(name+"_enabled");c.type="checkbox";toggles.set(c.name,c)}let ready:(()=>void)|undefined;const selectors:string[]=[];return {form,toggles,selectors,start(){runInNewContext(createQueryPresetCode,{location:{search},URLSearchParams,HTMLFormElement:Form,HTMLInputElement:Input,HTMLSelectElement:Select,HTMLTextAreaElement:TextArea,HTMLDetailsElement:Details,Event:class{type:string;constructor(type:string,_opts:object){this.type=type}},document:{readyState,querySelector(selector:string){selectors.push(selector);assert.equal(selector,'form.create-form[data-query-preset]');return present?form:null},getElementById(id:string){return toggles.get(id)??null},addEventListener(name:string,fn:()=>void,options:{once:boolean}){assert.equal(name,"DOMContentLoaded");assert.equal(options.once,true);ready=fn}}})},ready(){assert(ready);ready()}}}
test("loading時はDOMContentLoadedまで待ちrestore指定とform不在は設定しない",()=>{const p=page("?restore=1&target_url=https%3A%2F%2Fexample.com","loading");p.start();assert.deepEqual(p.selectors,[]);p.ready();assert.equal(p.selectors.length,1);assert.deepEqual(p.form.events,[]);const missing=page("?target_url=x","complete",false);missing.start();assert.deepEqual(missing.form.events,[])});
test("許可text checkbox radio selectを設定し不正select・未知queryを無視する",()=>{const p=page("?target_url=https%3A%2F%2Fexample.com&word_slug_enabled=true&preview_mode=custom&limit_reached_action=invalid&passphrase=secret"),target=new TextArea("target_url"),word=new Input("word_slug_enabled"),a=new Input("preview_mode"),b=new Input("preview_mode"),limit=new Select("limit_reached_action"),secret=new Input("passphrase");word.type="checkbox";a.type=b.type="radio";a.value="none";b.value="custom";limit.options=[{value:"end"},{value:"redirect"}];limit.value="end";p.form.controls.push(target,word,a,b,limit,secret);p.start();assert.equal(target.value,"https://example.com");assert.equal(word.checked,true);assert.equal(a.checked,false);assert.equal(b.checked,true);assert.equal(limit.value,"end");assert.equal(secret.value,"");assert.deepEqual(word.events,["change"]);assert.deepEqual(p.form.events,["input","change"])});
test("明示falseは値が設定されても条件を無効にし別の有効条件は詳細を開く",()=>{const p=page("?unlock_at=2026-10-12T09%3A00&period_enabled=false&max_open_count=5"),date=new Input("unlock_at"),limit=new Input("max_open_count");p.form.controls.push(date,limit);p.start();assert.equal(date.value,"2026-10-12T09:00");assert.equal(p.toggles.get("period_enabled")?.checked,false);assert.deepEqual(p.toggles.get("period_enabled")?.events,["change"]);assert.equal(p.toggles.get("limit_enabled")?.checked,true);assert.equal(p.form.details.open,true)});
test("入口queryはaudienceを有効にし許可集合外preview値は保持する",()=>{const p=page("?entry_label=Team&entry_preview_mode=other"),label=new Input("entry_label"),mode=new Select("entry_preview_mode");mode.options=[{value:"none"},{value:"custom"}];mode.value="none";p.form.controls.push(label,mode);p.start();assert.equal(label.value,"Team");assert.equal(mode.value,"none");assert.equal(p.toggles.get("audience_enabled")?.checked,true);assert.equal(p.form.details.open,true)});
test("許可集合でもselectにない値は設定せず明示true条件だけ開く",()=>{const p=page("?preview_mode=custom&protection_enabled=1"),mode=new Select("preview_mode");mode.options=[{value:"none"}];mode.value="none";p.form.controls.push(mode);p.start();assert.equal(mode.value,"none");assert.equal(p.toggles.get("preview_enabled")?.checked,false);assert.deepEqual(p.toggles.get("preview_enabled")?.events,[]);assert.equal(p.toggles.get("protection_enabled")?.checked,true);assert.equal(p.form.details.open,true)});
test("該当controlがなく未知queryだけでもform通知はinput change順で一回",()=>{const p=page("?target_url=x&unknown=y");p.start();assert.equal(p.form.details.open,false);assert.deepEqual(p.form.events,["input","change"]);for(const t of p.toggles.values())assert.deepEqual(t.events,[])});
