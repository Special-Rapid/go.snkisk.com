import assert from "node:assert/strict";
import test from "node:test";
import {runInNewContext} from "node:vm";
import {createFormRecoveryCode} from "../src/create-form-recovery-script.ts";
class ElementMock {
 one=new Map<string,ElementMock>();lists=new Map<string,ElementMock[]>();listeners=new Map<string,((event:Event)=>void)[]>();dataset={createErrorFocus:""};classes=new Set<string>();classList={add:(name:string)=>this.classes.add(name)};details:DetailsMock|null=null;scrolled:string[]=[];
 querySelector(selector:string){return this.one.get(selector)??null;}querySelectorAll(selector:string){return this.lists.get(selector)??[];}closest(selector:string){assert.equal(selector,"details.create-details");return this.details;}scrollIntoView(options:{block:string}){this.scrolled.push(options.block);}addEventListener(type:string,callback:(event:Event)=>void){const a=this.listeners.get(type)??[];a.push(callback);this.listeners.set(type,a);}dispatchEvent(event:Event){for(const fn of this.listeners.get(event.type)??[])fn(event);return true;}
}
class InputMock extends ElementMock{name="";id="";type="text";value="";checked=false;}
class SelectMock extends ElementMock{name="";value="";}
class TextareaMock extends ElementMock{name="";value="";}
class FormMock extends ElementMock{events:{type:string,bubbles:boolean}[]=[];dispatchEvent(event:Event){this.events.push({type:event.type,bubbles:event.bubbles});return super.dispatchEvent(event);}}
class DetailsMock extends ElementMock{open=false;}
function page(search="",draft:string|null=null){
 const studio=new ElementMock(),form=new FormMock(),controls:(InputMock|SelectMock|TextareaMock)[]=[],toggles:InputMock[]=[],ids=new Map<string,ElementMock>(),frames:(()=>void)[]=[],storage=new Map<string,string>(),calls:string[]=[];if(draft!==null)storage.set("go_create_form_draft_v1",draft);studio.one.set("form.create-form",form);form.lists.set("input,select,textarea",controls);form.lists.set("[data-condition-toggle]",toggles);
 const document={querySelector(selector:string){assert.equal(selector,".create-studio");return studio;},getElementById(id:string){return ids.get(id)??null;}};
 return{studio,form,controls,toggles,ids,frames,storage,calls,input(name:string,type="text",value="",checked=false){const x=new InputMock();Object.assign(x,{name,type,value,checked});controls.push(x);return x;},start(){runInNewContext(createFormRecoveryCode,{document,location:{search},URLSearchParams,Event,HTMLElement:ElementMock,HTMLFormElement:FormMock,HTMLInputElement:InputMock,HTMLSelectElement:SelectMock,HTMLTextAreaElement:TextareaMock,HTMLDetailsElement:DetailsMock,sessionStorage:{getItem(key:string){calls.push("get");return storage.get(key)??null;},setItem(key:string,value:string){calls.push("set");storage.set(key,value);},removeItem(key:string){calls.push("remove");storage.delete(key);}},requestAnimationFrame(fn:()=>void){frames.push(fn);}});},tick(){const fn=frames.shift();assert(fn);fn();}};
}
test("submit保存はsecret・名前なし・未選択radioを除外しcheckboxとtoggleを保持する",()=>{const p=page();p.input("target_url","url","https://x");p.input("passphrase","text","private-test-value");p.input("cf-turnstile-response","hidden","test-response");p.input("","text","empty-name");p.input("radio","radio","off",false);p.input("radio","radio","on",true);p.input("check","checkbox","1",false);const t=p.input("period_enabled","checkbox","1",true);t.id="period_enabled";p.toggles.push(t);p.start();p.form.dispatchEvent(new Event("submit"));const raw=p.storage.get("go_create_form_draft_v1");assert(raw);const saved=JSON.parse(raw);assert.deepEqual(saved,{values:{target_url:"https://x",radio:"on",check:false,period_enabled:true},toggles:{period_enabled:true}});});
test("restore以外のqueryではstorageを読まず復元イベントも送らない",()=>{for(const search of ["","?restore=0","?restore=true"]){const p=page(search,"{}");p.start();assert.deepEqual(p.calls,[]);assert.deepEqual(p.form.events,[]);}});
test("restoreは値種別を保ちtoggleのchange後にform input changeを送る",()=>{const p=page("?restore=1",JSON.stringify({values:{radio:"yes",check:"",text:42},toggles:{period:true}}));const radio=p.input("radio","radio","yes"),check=p.input("check","checkbox","1",true),text=p.input("text","text"),toggle=new InputMock();toggle.id="period";p.ids.set("period",toggle);let bubbles=false;toggle.addEventListener("change",e=>{bubbles=e.bubbles;});p.start();assert(radio.checked);assert.equal(check.checked,false);assert.equal(text.value,"42");assert(toggle.checked&&bubbles);assert.deepEqual(p.calls,["get","remove"]);assert.deepEqual(p.form.events,[{type:"input",bubbles:true},{type:"change",bubbles:true}]);});
test("不正JSONの復元失敗もfocusとform通知を維持しdraftは除去しない",()=>{const p=page("?restore=1","{bad"),target=new ElementMock(),details=new DetailsMock();target.details=details;p.ids.set("period",target);p.studio.dataset.createErrorFocus="period";p.start();assert(target.classes.has("has-server-error"));assert(details.open);assert.deepEqual(target.scrolled,[]);p.tick();assert.deepEqual(target.scrolled,["center"]);assert.deepEqual(p.calls,["get"]);assert.equal(p.form.events.length,2);});
test("selectとtextareaも復元し保存の除外を復元へ追加しない",()=>{const p=page("?restore=1",JSON.stringify({values:{choice:false,area:null,passphrase:"injected-local-value"}})),select=new SelectMock(),area=new TextareaMock();select.name="choice";area.name="area";p.controls.push(select,area);const pass=p.input("passphrase");p.start();assert.equal(select.value,"false");assert.equal(area.value,"null");assert.equal(pass.value,"injected-local-value");});
test("form型が違う場合はstorageとlistenerへ触れない",()=>{const p=page("?restore=1","{}");p.studio.one.set("form.create-form",new ElementMock());p.start();assert.deepEqual(p.calls,[]);assert.equal(p.form.listeners.size,0);});
