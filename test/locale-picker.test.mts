import assert from "node:assert/strict";
import test from "node:test";
import {runInNewContext} from "node:vm";
import {localePickerCode} from "../src/locale-picker-script.ts";
class ElementMock {dataset:Record<string,string|undefined>={};attributes:Record<string,string>={};styles:Record<string,string>={};style={setProperty:(k:string,v:string)=>this.styles[k]=v};setAttribute(k:string,v:string){this.attributes[k]=v}}
class ButtonMock extends ElementMock {value:string;tabIndex=9;textContent:string|null="old";focused=false;listeners=new Map<string,((event:KeyMock)=>void)[]>();constructor(value:string){super();this.value=value}addEventListener(type:string,fn:(event:KeyMock)=>void){this.listeners.set(type,[...this.listeners.get(type)??[],fn])}focus(){this.focused=true}emit(type:string,key=""){const e={key,prevented:false,preventDefault(){this.prevented=true}};for(const fn of this.listeners.get(type)??[])fn(e);return e}}
type KeyMock={key:string;prevented:boolean;preventDefault:()=>void};
class InputMock extends ElementMock {value:string;clicks=0;constructor(value:string){super();this.value=value}click(){this.clicks++}}
class SelectMock extends ElementMock {value="";events:{type:string,bubbles:boolean}[]=[];dispatchEvent(e:Event){this.events.push({type:e.type,bubbles:e.bubbles});return true}}
function page(lang="ja",theme:string|undefined="auto",stored:string|null=null,dark=false,legacy=false){
 const root=new ElementMock();root.dataset.theme=theme;const documentRoot=Object.assign(root,{lang}),themeToggle=new ElementMock(),languageToggle=new ElementMock(),meta=new ElementMock(),themeButtons=["light","auto","dark"].map(x=>new ButtonMock(x)),languageButtons=["ja","auto","en"].map(x=>new ButtonMock(x)),themeRadios=["auto","light","dark"].map(x=>new InputMock(x)),localePicker=new SelectMock(),frames:(()=>void)[]=[],localeCalls:string[]=[],storageCalls:string[]=[];
 const dom=new Map<string,ElementMock>([["[data-theme-toggle]",themeToggle],["[data-language-toggle]",languageToggle],["#ui_locale",localePicker],["meta[name=\"theme-color\"]",meta]]),lists=new Map<string,ElementMock[]>([["[data-theme-toggle] [role=radio]",themeButtons],["[data-language-toggle] [role=radio]",languageButtons],["input[name=go_theme]",themeRadios]]),listeners=new Map<string,{fn:()=>void,once:boolean}[]>();let observer:(()=>void)|undefined,osListener:(()=>void)|undefined;
 const appearance={matches:dark,addEventListener:legacy?undefined:(type:string,fn:()=>void)=>{assert.equal(type,"change");osListener=fn},addListener:(fn:()=>void)=>{osListener=fn}},window:{goSetUiLocale?:unknown}={};
 const document={documentElement:documentRoot,querySelector:(s:string)=>dom.get(s)??null,querySelectorAll:(s:string)=>lists.get(s)??[],addEventListener(name:string,fn:()=>void,options?:{once?:boolean}){listeners.set(name,[...listeners.get(name)??[],{fn,once:options?.once??false}])}};
 return {root:documentRoot,themeToggle,languageToggle,meta,themeButtons,languageButtons,themeRadios,localePicker,frames,localeCalls,storageCalls,dom,lists,window,appearance,storageError:false,
  start(){const self=this;runInNewContext(localePickerCode,{document,window,Event,HTMLElement:ElementMock,HTMLButtonElement:ButtonMock,HTMLInputElement:InputMock,HTMLSelectElement:SelectMock,localStorage:{getItem(k:string){storageCalls.push(k);if(self.storageError)throw Error("storage denied");return stored}},requestAnimationFrame:(fn:()=>void)=>frames.push(fn),matchMedia:(s:string)=>{assert.equal(s,"(prefers-color-scheme: dark)");return appearance},MutationObserver:class{constructor(fn:()=>void){observer=fn}observe(target:ElementMock,options:object){assert.equal(target,root);assert.deepEqual(JSON.parse(JSON.stringify(options)),{attributes:true,attributeFilter:["data-theme","lang"]})}}})},
  emit(name:string){const pending=listeners.get(name)??[];listeners.set(name,pending.filter(x=>!x.once));for(const x of pending)x.fn()},mutate(){assert(observer);observer()},changeOS(){assert(osListener);osListener()},tick(){const fn=frames.shift();assert(fn);fn()},
 };
}
test("DOMContentLoaded onceでtheme・languageの現在値とariaを同期する",()=>{const p=page("en","dark","ja");p.start();assert.equal(p.themeButtons[2].textContent,"old");p.emit("DOMContentLoaded");assert.deepEqual(p.themeButtons.map(x=>[x.textContent,x.attributes["aria-checked"],x.tabIndex]),[["Light","false",-1],["System","false",-1],["Dark","true",0]]);assert.equal(p.themeToggle.attributes["aria-label"],"Theme");assert.equal(p.languageButtons[0].attributes["aria-checked"],"true");assert.equal(p.meta.attributes.content,"#171816");const count=p.storageCalls.length;p.emit("DOMContentLoaded");assert.equal(p.storageCalls.length,count)});
test("無効theme・保存言語はautoへ戻りOS appearanceとlegacy通知を同期する",()=>{for(const legacy of [false,true]){const p=page("ja","bad","fr",false,legacy);p.start();p.emit("DOMContentLoaded");assert.equal(p.themeToggle.dataset.scene,"system");assert.equal(p.languageButtons[1].attributes["aria-checked"],"true");p.appearance.matches=true;p.changeOS();assert.equal(p.meta.attributes.content,"#171816");p.root.dataset.theme="light";p.mutate();assert.equal(p.meta.attributes.content,"#f7efe6");p.changeOS();assert.equal(p.meta.attributes.content,"#f7efe6")}});
test("radioのclickは対応inputだけへ伝えlanguage callback不在はselect通知を使う",()=>{const p=page();p.start();p.emit("DOMContentLoaded");p.themeButtons[2].emit("click");assert.deepEqual(p.themeRadios.map(x=>x.clicks),[0,0,1]);p.languageButtons[2].emit("click");assert.equal(p.localePicker.value,"en");assert.deepEqual(p.localePicker.events,[{type:"change",bubbles:true}]);p.window.goSetUiLocale=(value:string)=>p.localeCalls.push(value);p.languageButtons[0].emit("click");assert.deepEqual(p.localeCalls,["ja"]);assert.equal(p.localePicker.events.length,1)});
test("方向キーとHome/Endは循環選択後RAFでfocusし未知keyを保持する",()=>{const p=page();p.start();p.emit("DOMContentLoaded");assert(p.languageButtons[0].emit("keydown","ArrowLeft").prevented);assert.equal(p.localePicker.value,"en");assert.equal(p.languageButtons[2].focused,false);p.tick();assert(p.languageButtons[2].focused);assert(p.languageButtons[2].emit("keydown","Home").prevented);assert.equal(p.localePicker.value,"ja");p.tick();assert(p.languageButtons[0].focused);assert(p.languageButtons[0].emit("keydown","End").prevented);assert.equal(p.localePicker.value,"en");assert.equal(p.languageButtons[0].emit("keydown","Escape").prevented,false)});
test("lang属性とlocale通知は既存buttonsの文言を同期し未知button値を保持する",()=>{const p=page("ja","light","en");p.themeButtons[0].value="unknown";p.start();p.emit("DOMContentLoaded");assert.equal(p.themeButtons[0].textContent,"unknown");assert.equal(p.languageButtons[0].textContent,"日本語");p.root.lang="en";p.mutate();assert.equal(p.languageButtons[0].textContent,"Japanese");p.root.lang="ja";p.emit("go:localechange");assert.equal(p.languageButtons[0].textContent,"日本語");assert.equal(p.themeButtons[0].textContent,"unknown")});
test("storage例外と要素欠落は既存fallbackを保ち余計なnavigationを追加しない",()=>{const p=page();p.storageError=true;p.dom.delete("[data-theme-toggle]");p.dom.delete("#ui_locale");p.start();p.emit("DOMContentLoaded");assert.equal(p.languageButtons[1].attributes["aria-checked"],"true");p.languageButtons[2].emit("click");assert.deepEqual(p.localePicker.events,[]);assert.deepEqual(p.localeCalls,[])});
