import assert from "node:assert/strict";
import test from "node:test";
import {runInNewContext} from "node:vm";
import {settingInfoCode} from "../src/setting-info-script.ts";
class ElementMock {
 one=new Map<string,ElementMock>();lists=new Map<string,ElementMock[]>();listeners=new Map<string,(()=>void)[]>();attrs=new Map<string,string>();dataset:Record<string,string>={};textContent="original";hidden=true;
 querySelector(selector:string){return this.one.get(selector)??null;}querySelectorAll(selector:string){return this.lists.get(selector)??[];}closest(selector:string){assert.equal(selector,".create-studio");return this.one.get(selector)??null;}setAttribute(name:string,value:string){this.attrs.set(name,value);}addEventListener(name:string,fn:()=>void){const a=this.listeners.get(name)??[];a.push(fn);this.listeners.set(name,a);}emit(name:string){for(const fn of this.listeners.get(name)??[])fn();}
}
class ButtonMock extends ElementMock{}
class InputMock extends ElementMock{checked=false;}
class DetailsMock extends ElementMock{open=false;}
function page(lang="ja",hash=""){
 const studio=new ElementMock(),script=new ElementMock(),details=new DetailsMock(),heading=new ElementMock(),ruleHeading=new ElementMock(),word=new ElementMock(),basic=new ButtonMock(),basicTooltip=new ElementMock(),card=new ElementMock(),title=new ElementMock(),state=new ElementMock(),toggle=new InputMock(),button=new ButtonMock(),tooltip=new ElementMock();script.one.set(".create-studio",studio);basic.dataset.createInfo="slug";card.dataset.conditionCard="period";
 for(const [selector,item] of [[".create-settings",details],["#create-settings-title",heading],[".rule-preview>h2",ruleHeading],["[data-word-slug-label]",word],["#create_slug_info",basicTooltip]] as const)studio.one.set(selector,item);
 for(const [selector,item] of [[".condition-card-title strong",title],["[data-condition-state]",state],["[data-condition-toggle]",toggle],["[data-condition-info]",button],[".condition-tooltip",tooltip]] as const)card.one.set(selector,item);
 studio.lists.set("[data-create-info]",[basic]);studio.lists.set("[data-condition-card]",[card]);const documentEvents=new ElementMock(),windowEvents=new ElementMock(),loadOptions:{once:boolean}[]=[];const document={currentScript:script as ElementMock|null,documentElement:{lang},activeElement:null as ElementMock|null,addEventListener(name:string,fn:()=>void){documentEvents.addEventListener(name,fn);}};const location={hash};
 return {studio,script,details,heading,ruleHeading,word,basic,basicTooltip,card,title,state,toggle,button,tooltip,document,documentEvents,windowEvents,location,loadOptions,start(){runInNewContext(settingInfoCode,{document,location,HTMLElement:ElementMock,HTMLButtonElement:ButtonMock,HTMLInputElement:InputMock,HTMLDetailsElement:DetailsMock,window:{addEventListener(name:string,fn:()=>void,options?:{once:boolean}){windowEvents.addEventListener(name,fn);if(options)loadOptions.push(options);}}});}};
}
test("初期日本語とfallbackは既存見出し・状態・tooltipを同期する",()=>{for(const lang of ["ja","fr",""]){const p=page(lang);p.start();assert.equal(p.heading.textContent,"設定（任意）");assert.equal(p.ruleHeading.textContent,"現在の動作");assert.equal(p.state.textContent,"未設定");assert.equal(p.title.textContent,"利用できる期間");assert.equal(p.basic.attrs.get("aria-label"),"短縮パスの形式を表示");assert.equal(p.button.attrs.get("aria-label"),"利用できる期間の説明を表示");}});
test("現在言語とtoggle通知は英語のstateと説明を更新する",()=>{const p=page();p.start();p.document.documentElement.lang="en";p.toggle.checked=true;p.toggle.emit("change");assert.equal(p.heading.textContent,"Optional settings");assert.equal(p.ruleHeading.textContent,"What happens now");assert.equal(p.state.textContent,"On");assert.equal(p.button.attrs.get("aria-label"),"Show Availability window help");p.document.documentElement.lang="ja";p.documentEvents.emit("go:localechange");assert.equal(p.state.textContent,"有効");assert.equal(JSON.stringify(p.loadOptions),JSON.stringify([{once:true}]));});
test("infoはclick focus enterで開きblurと非focus leaveで閉じる",()=>{const p=page();p.start();for(const [button,tooltip] of [[p.basic,p.basicTooltip],[p.button,p.tooltip]]){button.emit("click");assert.equal(tooltip.hidden,false);assert.equal(button.attrs.get("aria-expanded"),"true");button.emit("blur");assert.equal(tooltip.hidden,true);button.emit("mouseenter");p.document.activeElement=button;button.emit("mouseleave");assert.equal(tooltip.hidden,false);p.document.activeElement=null;button.emit("mouseleave");assert.equal(tooltip.hidden,true);button.emit("focus");assert.equal(tooltip.hidden,false);}});
test("条件hashとerrorfocusは詳細を開き無関係hashは保持する",()=>{for(const hash of ["#create-condition-period","#create-condition-%70eriod"]){const p=page("ja",hash);p.start();assert(p.details.open);}const p=page();p.studio.dataset.createErrorFocus="target_url";p.start();assert(p.details.open);const q=page();q.start();q.location.hash="#other";q.windowEvents.emit("hashchange");assert.equal(q.details.open,false);q.location.hash="#create-condition-limit";q.windowEvents.emit("hashchange");assert(q.details.open);});
test("未知copykeyを無視し不正hashの既存URIErrorを保持する",()=>{const p=page();p.basic.dataset.createInfo="unknown";p.card.dataset.conditionCard="unknown";p.start();assert.equal(p.basic.attrs.size,0);assert.equal(p.title.textContent,"original");const q=page("ja","#%bad");assert.throws(()=>q.start(),e=>e instanceof Error?e.name==="URIError":typeof e==="object"&&e!==null&&"name" in e&&e.name==="URIError");assert.equal(q.documentEvents.listeners.size,0);});
test("currentScriptやstudioがない場合はlistenerも表示も変更しない",()=>{const p=page();p.document.currentScript=null;p.start();assert.equal(p.heading.textContent,"original");assert.equal(p.windowEvents.listeners.size,0);const q=page();q.script.one.clear();q.start();assert.equal(q.windowEvents.listeners.size,0);});
