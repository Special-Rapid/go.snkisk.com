{
  "manifest_version": 3,
  "key": "",
  "name": "sinkaisoku.com",
  "version": "0.1.0",
  "description": "開いているページの短縮URLを、ポップアップを開くだけで作成します。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "sinkaisoku.com で短縮"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://sinkaisoku.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://sinkaisoku.com"
  }
}
